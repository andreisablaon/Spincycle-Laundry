<%- include('partials/header') %>
<h2>Laundry Orders Dashboard</h2>

<% if (user.role === 'customer') { %>
  <div class="card my-4 p-3 bg-light">
    <h4>Submit New Drop-off Request</h4>
    <form action="/orders/create" method="POST" class="row g-2">
      <div class="col-md-4">
        <select name="service" class="form-select" required>
          <option value="Wash & Fold">Wash & Fold (₱35/kg)</option>
          <option value="Dry Cleaning">Dry Cleaning</option>
          <option value="Duvet Wash">Duvet Wash</option>
        </select>
      </div>
      <div class="col-md-3">
        <input type="number" step="0.1" name="weight" placeholder="Est. Weight (kg)" class="form-control" required>
      </div>
      <div class="col-md-3">
        <input type="text" name="notes" placeholder="Special Instructions" class="form-control">
      </div>
      <div class="col-md-2">
        <button class="btn btn-primary w-100">Submit</button>
      </div>
    </form>
  </div>
<% } %>

<table class="table table-striped mt-4">
  <thead>
    <tr>
      <th>Order #</th>
      <% if (user.role === 'admin') { %><th>Customer</th><% } %>
      <th>Service</th>
      <th>Weight (kg)</th>
      <th>Price</th>
      <th>Status</th>
      <% if (user.role === 'admin') { %><th>Actions</th><% } %>
    </tr>
  </thead>
  <tbody>
    <% orders.forEach(o => { %>
      <tr>
        <td>#<%= o.id %></td>
        <% if (user.role === 'admin') { %><td><%= o.customer_name %></td><% } %>
        <td><%= o.service %></td>
        <td><%= o.weight %></td>
        <td>₱<%= o.price %></td>
        <td><span class="badge bg-info"><%= o.status %></span></td>
        <% if (user.role === 'admin') { %>
          <td>
            <form action="/orders/update/<%= o.id %>" method="POST" class="d-inline-flex me-1">
              <select name="status" class="form-select form-select-sm me-1">
                <option value="Pending" <%= o.status==='Pending'?'selected':'' %>>Pending</option>
                <option value="Washing" <%= o.status==='Washing'?'selected':'' %>>Washing</option>
                <option value="Ready for Pickup" <%= o.status==='Ready for Pickup'?'selected':'' %>>Ready for Pickup</option>
                <option value="Completed" <%= o.status==='Completed'?'selected':'' %>>Completed</option>
              </select>
              <input type="number" name="price" value="<%= o.price %>" class="form-control form-control-sm me-1" style="width:70px">
              <button class="btn btn-sm btn-success">Save</button>
            </form>
            <form action="/orders/delete/<%= o.id %>" method="POST" class="d-inline" onsubmit="return confirm('Delete this order?')">
              <button class="btn btn-sm btn-danger">Delete</button>
            </form>
          </td>
        <% } %>
      </tr>
    <% }) %>
  </tbody>
</table>
<%- include('partials/footer') %>